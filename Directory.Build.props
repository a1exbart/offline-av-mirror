<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are for readers of the source, not a published API surface. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Authors>Alex Kolodchenko</Authors>
    <Copyright>Copyright 2026 Alex Kolodchenko</Copyright>
    <Product>offline-av-mirror</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/a1exbart/offline-av-mirror</RepositoryUrl>

    <!-- CI passes the version derived from the git tag; local builds say so. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- Locked restore only without a runtime identifier: a RID publish pulls in
         its own graph (ILLink and the runtime packs) and would never match a lock
         file written by a plain restore. The versions themselves are pinned
         centrally either way. -->
    <RestoreLockedMode Condition="'$(RuntimeIdentifier)' == ''">true</RestoreLockedMode>
  </PropertyGroup>

</Project>
